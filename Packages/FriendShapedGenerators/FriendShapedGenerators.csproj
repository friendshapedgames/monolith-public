<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Roslyn generators must target netstandard2.0 -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- No analyzer release tracking; the generator isn't shipped as a package -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>
        <Company>Friend Shaped Games</Company>
        <Product>Friend Shaped Games Source Generators</Product>
        <RootNamespace>FriendShapedGenerators</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all"/>
    </ItemGroup>

</Project>
